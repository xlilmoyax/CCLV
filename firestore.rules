rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Validations
    match /approved_workers/{email} {
      allow read: if true;
      allow write: if email is string && email.size() <= 100;
    }

    match /pending_workers/{email} {
      allow read: if true;
      allow write: if email is string && email.size() <= 100;
    }

    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }

    match /incidents/{incidentId} {
      allow read: if true;
      allow write: if isValidId(incidentId);
    }

    match /preventive_tasks/{taskId} {
      allow read: if true;
      allow write: if isValidId(taskId);
    }

    match /activities/{activityId} {
      allow read: if true;
      allow write: if isValidId(activityId);
    }

    match /eddie_memories/{memoryId} {
      allow read: if true;
      allow write: if isValidId(memoryId);
    }

    match /chats/{chatId} {
      allow read: if true;
      allow write: if isValidId(chatId);
    }
  }
}
